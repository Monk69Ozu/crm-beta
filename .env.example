# ── WebArs CRM — Environment Variables ───────────────────────────
# In Coolify: set these in the service's Environment Variables UI.

# MySQL connection string (Coolify provides this automatically
# when you attach a MySQL service to your app)
DATABASE_URL=mysql://user:password@host:3306/dbname

# API secret — the CRM frontend will ask you for this once during
# setup (replaces the GitHub token). Generate a strong random value.
API_SECRET=change-me-to-a-strong-random-secret

# Port the server listens on (Coolify default: 3000)
PORT=3000
